DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/system_agent
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5
SECRET_KEY=your-secret-key-change-in-production
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
APP_TIMEZONE=Asia/Shanghai
ENABLE_SCHEDULER=true
SCHEDULER_IN_API=true
SCHEDULER_PERSIST_JOBS=true
# Leave empty to reuse REDIS_URL. In multi-process production, run `python -m scripts.scheduler`
# in one standalone process and set SCHEDULER_IN_API=false on API instances.
SCHEDULER_REDIS_URL=
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
DEFAULT_RATE_LIMIT=120/minute
CHAT_RATE_LIMIT=20/minute
CHAT_IP_RATE_LIMIT=60/minute
UPLOAD_RATE_LIMIT=10/hour
UPLOAD_IP_RATE_LIMIT=30/hour
ASSESSMENT_RATE_LIMIT=10/hour
ASSESSMENT_IP_RATE_LIMIT=30/hour
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
MAX_UPLOAD_SIZE_MB=8
MAX_REQUEST_BODY_MB=40
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_CHAT_MODEL=qwen-plus
AI_ANALYSIS_MODEL=qwen-plus
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1536
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
AGENT_LOCK_TTL_SECONDS=180
AGENT_LOCK_WAIT_SECONDS=0.25
AI_MAX_CONCURRENCY=8
EMBEDDING_MAX_CONCURRENCY=4
FACEPLUS_MAX_CONCURRENCY=3
AI_GATE_WAIT_SECONDS=2
AI_GATE_LEASE_SECONDS=90
AI_BUDGET_ENFORCEMENT=true
AI_USER_DAILY_CALL_LIMIT=200
AI_GLOBAL_DAILY_CALL_LIMIT=5000
AI_USER_DAILY_TOKEN_LIMIT=300000
AI_GLOBAL_DAILY_TOKEN_LIMIT=5000000
WORKER_CONCURRENCY=4
WORKER_AI_CONCURRENCY=2
WORKER_BATCH_SIZE=10
WORKER_STALE_JOB_IDLE_MS=300000
# Required in production; local loopback access is allowed when empty in development.
OPS_METRICS_TOKEN=
SECURITY_HEADERS_ENABLED=true
FACEPLUSPLUS_API_KEY=
FACEPLUSPLUS_API_SECRET=
FACEPLUSPLUS_API_URL=https://api-cn.faceplusplus.com/facepp/v1/skinanalyze
TRACE_RETENTION_DAYS=30
PHOTO_RETENTION_DAYS=365
TEMP_UPLOAD_RETENTION_HOURS=24
NOTIFICATION_RETENTION_DAYS=90
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_EMAIL=mailto:you@example.com
# JSON array; limits server-side delivery endpoints to trusted push providers.
WEB_PUSH_ALLOWED_HOST_SUFFIXES=["googleapis.com","push.services.mozilla.com","notify.windows.com","push.apple.com"]
